@inject IJSRuntime JS
@inject HttpClient Http

<header class="app-header">
    <h1>Wildlife Survey Data Validator</h1>
    <div class="toolbar">
        <label class="btn primary @(template is null ? "disabled" : null)" title="Open a survey data file (.dat or .csv) from this computer">
            Open data file
            <InputFile @key="fileInputKey" class="visually-hidden" OnChange="OnDataFileChosen" accept=".dat,.csv,.txt"
                       disabled="@(template is null)" />
        </label>
        <button class="btn" disabled="@(doc is null)" @onclick="DownloadCsv"
                title="Save the cleaned data to this computer as a CSV file">
            Download cleaned CSV
        </button>
        <button class="btn" disabled="@(doc is null || doc.DeletedCount == 0)" @onclick="UndoDelete">
            Undo delete@(doc is { DeletedCount: > 0 } ? $" ({doc.DeletedCount})" : "")
        </button>
        <span class="spacer"></span>
        <span class="config-name" title="The config file the data is checked against">Config: @templateName</span>
        <button class="btn quiet" aria-expanded="@showConfig" @onclick="() => showConfig = !showConfig">Config</button>
        <button class="btn quiet" aria-expanded="@showHelp" @onclick="() => showHelp = !showHelp">Help</button>
    </div>
</header>

@if (pendingAction is not null)
{
    <div class="confirm" role="alertdialog">
        <span>@pendingMessage</span>
        <button class="btn danger" @onclick="ConfirmPending">Discard edits and continue</button>
        <button class="btn" @onclick="CancelPending">Cancel</button>
    </div>
}

@if (showHelp)
{
    <section class="panel">
        <h2>About</h2>
        <p>
            This application checks and cleans aerial wildlife survey data. Open a data file, fix or delete the
            highlighted lines, then download the result as a CSV file. The file is read and cleaned in this browser;
            it is not sent anywhere.
        </p>
        <p>
            What counts as a valid entry comes from the data logger's button config file
            (<code>GamepadAudioConfig.csv</code>). Load a different config in the Config panel and the checks,
            the lists and the saved columns change to match.
        </p>
        @if (template is not null)
        {
            <p>Each record needs three entries:</p>
            <ul>
                <li>Species: @string.Join(", ", template.Species)</li>
                <li>Distance class (one only): @string.Join(", ", template.DistanceClasses)</li>
                <li>Count (one or more, comma-separated): @string.Join(", ", template.Counts)</li>
            </ul>
            <p>
                <b>GroupSize</b> is calculated by the program: it is the counts added together, so counts of
                4, 4 and 2 give a group size of 10.
            </p>
        }
        <ul class="legend">
            <li><span class="swatch row-incomplete"></span> Record with a missing entry (the empty cell is marked in gold)</li>
            <li><span class="swatch row-multi"></span> Record with more than one distance class: choose one</li>
            <li><span class="swatch row-transect"></span> Transect marker out of sequence</li>
            <li><span class="swatch row-delete"></span> Record the observer marked for deletion: delete it or keep it</li>
        </ul>
        <p>
            Species and distance are chosen from lists. Counts are typed. The 11 auto-recorded columns
            (time to HTOL) are shown to the right: double-click one to edit it, then press Enter to keep the
            change or Escape to abandon it. The downloaded file keeps the original column order.
        </p>
    </section>
}

@if (showConfig)
{
    <section class="panel">
        <h2>Config <small>(@templateName)</small></h2>
        <p>
            The values below were read from the config file. The program works out what each recorded value
            means from its row. If one is wrong, change it here; the choice is remembered in this browser.
        </p>
        <div class="toolbar">
            <label class="btn">
                Load config file
                <InputFile @key="templateInputKey" class="visually-hidden" OnChange="OnConfigFileChosen" accept=".csv,.txt" />
            </label>
            <button class="btn" disabled="@(template is null)" @onclick="DownloadTemplate"
                    title="Save these values and their meanings as a file that can be loaded again">
                Download as template
            </button>
            <button class="btn" @onclick="ResetConfig">Reset to built-in config</button>
        </div>
        @if (template is not null)
        {
            <table class="config">
                <thead>
                    <tr><th>Recorded value</th><th>Spoken as</th><th>Meaning</th></tr>
                </thead>
                <tbody>
                    @foreach (TemplateEntry entry in template.Entries)
                    {
                        TemplateEntry e = entry;
                        <tr @key="e.Value">
                            <td><code>@e.Value</code></td>
                            <td>@e.Description</td>
                            <td>
                                <select value="@e.Role" aria-label="Meaning of @e.Value" @onchange="ev => OnRoleChanged(e, ev)">
                                    @foreach (ValueRole role in Enum.GetValues<ValueRole>())
                                    {
                                        <option value="@role">@SurveyTemplate.RoleLabel(role)</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@if (doc is null || template is null)
{
    <section class="empty">
        @if (template is null)
        {
            <p>@(configLoading ? "Loading the config…" : "No config is loaded. Open the Config panel and load the logger's config file.")</p>
        }
        else
        {
            <p>Open a survey data file to begin.</p>
            <p class="muted">The file stays on this computer. Nothing is uploaded.</p>
        }
    </section>
}
else
{
    SurveySummary s = doc.Summary;
    bool showOther = template.OtherValues.Count > 0;
    <section class="summary">
        <div class="filters" role="group" aria-label="Show rows">
            <button class="chip" aria-pressed="@(filter == RowFilter.All)" @onclick="() => SetFilter(RowFilter.All)">
                All <b>@s.Total</b>
            </button>
            <button class="chip row-incomplete" aria-pressed="@(filter == RowFilter.Incomplete)" @onclick="() => SetFilter(RowFilter.Incomplete)">
                Incomplete <b>@s.Incomplete</b>
            </button>
            <button class="chip row-multi" aria-pressed="@(filter == RowFilter.MultipleDistances)" @onclick="() => SetFilter(RowFilter.MultipleDistances)">
                Multiple distances <b>@s.MultipleDistances</b>
            </button>
            <button class="chip row-transect" aria-pressed="@(filter == RowFilter.TransectErrors)" @onclick="() => SetFilter(RowFilter.TransectErrors)">
                Transect errors <b>@s.TransectErrors</b>
            </button>
            <button class="chip row-delete" aria-pressed="@(filter == RowFilter.DeleteRequests)" @onclick="() => SetFilter(RowFilter.DeleteRequests)">
                Marked for deletion <b>@s.DeleteRequests</b>
            </button>
        </div>
        <span class="counts">
            @s.Complete complete
            @if (template.TransectStart.Length > 0 || template.TransectEnd.Length > 0)
            {
                <text>
                    &middot; @template.TransectStart: @s.TransectStartCount, @template.TransectEnd: @s.TransectEndCount
                    <b class="@(s.TransectMarkersMatch ? "good" : "bad")">@(s.TransectMarkersMatch ? "matched" : "MISMATCH")</b>
                </text>
            }
        </span>
        <label class="toggle">
            <input type="checkbox" @bind="hideFixed" /> Hide the 11 auto-recorded columns
        </label>
    </section>

    <div class="grid-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th></th>
                    <th class="num">Line</th>
                    <th>Species</th>
                    <th>Counts</th>
                    <th class="num" title="Calculated: the counts added together">GroupSize</th>
                    <th>Distance</th>
                    <th>Recorded distances</th>
                    @if (showOther)
                    {
                        <th>Other</th>
                    }
                    <th>Notes</th>
                    @if (!hideFixed)
                    {
                        @foreach (string name in SurveyRecord.FixedColumnNames)
                        {
                            <th>@name</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="view" Context="r" ItemSize="33" OverscanCount="20" SpacerElement="tr">
                    <tr @key="r" class="@RowClass(r)">
                        <td class="actions">
                            <button class="delete" title="Delete line @r.Line" aria-label="Delete line @r.Line" @onclick="() => DeleteRow(r)">&#x2715;</button>
                        </td>
                        <td class="num">@r.Line</td>
                        <td class="@(r.IsMissing("species") ? "flag" : null)">
                            <select value="@r.Species" aria-label="Species" @onchange="e => OnSpecies(r, e)">
                                <option value=""></option>
                                @foreach (string sp in template.Species)
                                {
                                    <option value="@sp">@sp</option>
                                }
                                @if (template.TransectStart.Length > 0)
                                {
                                    <option value="@template.TransectStart">@template.TransectStart</option>
                                }
                                @if (template.TransectEnd.Length > 0)
                                {
                                    <option value="@template.TransectEnd">@template.TransectEnd</option>
                                }
                            </select>
                        </td>
                        <td class="@(r.IsMissing("count") ? "flag" : null)">
                            @if (!r.IsTransectMarker)
                            {
                                <input @key="(r, inputEpoch)" class="counts-box" value="@r.Counts" aria-label="Counts"
                                       @onchange="e => OnCounts(r, e)" />
                            }
                        </td>
                        <td class="num calc">@(r.IsTransectMarker ? null : r.GroupSize)</td>
                        <td class="@(r.IsMissing("distance") || r.HasMultipleDistances ? "flag" : null)">
                            @if (!r.IsTransectMarker)
                            {
                                <select value="@r.Distance" aria-label="Distance" @onchange="e => OnDistance(r, e)">
                                    <option value=""></option>
                                    @foreach (string d in template.DistanceClasses)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            }
                        </td>
                        <td class="@(r.HasMultipleDistances ? "flag" : null)">
                            @if (r.HasMultipleDistances)
                            {
                                @foreach (string d in r.RecordedDistances)
                                {
                                    string choice = d;
                                    <button class="pick" title="Use this distance" @onclick="() => ChooseDistance(r, choice)">@choice</button>
                                }
                            }
                            else
                            {
                                @r.AllDistancesText
                            }
                        </td>
                        @if (showOther)
                        {
                            <td>
                                @if (!r.IsTransectMarker)
                                {
                                    <input @key="(r, inputEpoch, 1)" class="other-box" value="@r.Other" aria-label="Other observations"
                                           title="Separate several with a semicolon" @onchange="e => OnOther(r, e)" />
                                }
                            </td>
                        }
                        <td class="notes" title="@r.Notes">
                            @if (r.DeleteRequested)
                            {
                                <button class="pick" title="Keep this record and clear the mark" @onclick="() => KeepRow(r)">Keep</button>
                            }
                            @r.Notes
                        </td>
                        @if (!hideFixed)
                        {
                            @for (int i = 0; i < SurveyRecord.FixedColumnCount; i++)
                            {
                                int col = i;
                                @if (ReferenceEquals(editRecord, r) && editColumn == col)
                                {
                                    <td class="editing">
                                        <input @ref="editInput" value="@editText"
                                               aria-label="@SurveyRecord.FixedColumnNames[col]"
                                               @oninput="e => editText = e.Value?.ToString() ?? string.Empty"
                                               @onkeydown="OnEditKey" @onblur="CommitEdit" />
                                    </td>
                                }
                                else
                                {
                                    <td title="Double-click to edit" @ondblclick="() => BeginEdit(r, col)">@r.Fixed[col]</td>
                                }
                            }
                        }
                    </tr>
                </Virtualize>
            </tbody>
        </table>
        @if (view.Count == 0)
        {
            <p class="empty-filter">No rows to show for this filter.</p>
        }
    </div>
}

<footer class="status @(statusIsError ? "error" : null)" role="status">@status</footer>

@code {
    private enum RowFilter { All, Incomplete, MultipleDistances, TransectErrors, DeleteRequests }

    private const long MaxDataFileBytes = 100 * 1024 * 1024;
    private const long MaxConfigFileBytes = 1024 * 1024;
    private const string BuiltInConfigPath = "config/GamepadAudioConfig.csv";
    private const string BuiltInName = "GamepadAudioConfig.csv (built-in)";
    private const string StoredTemplateKey = "wildlifeSurveyValidator.template";
    private const string StoredTemplateNameKey = "wildlifeSurveyValidator.templateName";

    private SurveyTemplate? template;
    private string templateName = "none";
    private bool configLoading = true;

    private SurveyDocument? doc;
    private string? fileName;
    private string? rawText;

    private List<SurveyRecord> view = new();
    private RowFilter filter = RowFilter.All;
    private bool hideFixed;
    private bool showConfig;
    private bool showHelp;

    private string status = "Ready";
    private bool statusIsError;

    private int fileInputKey;
    private int templateInputKey;
    private int inputEpoch;

    // Cell being edited among the 11 auto-recorded columns.
    private SurveyRecord? editRecord;
    private int editColumn;
    private string editText = "";
    private ElementReference editInput;
    private bool focusEditInput;

    // An action waiting for the user to agree to lose unsaved edits.
    private Func<Task>? pendingAction;
    private string pendingMessage = "";

    private bool unsavedSentToBrowser;

    // ------------------------------------------------------------- lifecycle

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadStartupConfig();
            StateHasChanged();
        }

        if (focusEditInput)
        {
            focusEditInput = false;
            await JS.InvokeVoidAsync("surveyValidator.focus", editInput);
        }

        bool unsaved = doc?.IsModified == true;
        if (unsaved != unsavedSentToBrowser)
        {
            unsavedSentToBrowser = unsaved;
            await JS.InvokeVoidAsync("surveyValidator.setUnsaved", unsaved);
        }
    }

    private void SetStatus(string message, bool isError = false)
    {
        status = message;
        statusIsError = isError;
    }

    // ------------------------------------------------------------- data file

    private async Task OnDataFileChosen(InputFileChangeEventArgs e)
    {
        fileInputKey++; // lets the same file be chosen again later
        IBrowserFile file = e.File;
        string text;
        try
        {
            using Stream stream = file.OpenReadStream(MaxDataFileBytes);
            using var reader = new StreamReader(stream);
            text = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Error loading file: {ex.Message}", isError: true);
            return;
        }

        string name = file.Name;
        await RunUnlessUnsaved(
            $"Opening {name} will discard the edits made to {fileName}.",
            () => { LoadData(text, name); return Task.CompletedTask; });
    }

    private void LoadData(string text, string name)
    {
        if (template is null) return;
        rawText = text;
        fileName = name;
        doc = SurveyDocument.Load(text, template);
        editRecord = null;
        filter = RowFilter.All;
        RefreshView();

        SurveySummary s = doc.Summary;
        string message = $"File loaded: {name}. {s.Total} records, {s.Incomplete} incomplete, " +
                         $"{s.MultipleDistances} with multiple distances, {s.TransectErrors} transect errors, " +
                         $"{s.DeleteRequests} marked for deletion." + (doc.HadHeaderLine ? " Header line skipped." : "");
        bool mismatch = s.Total >= 4 && s.Incomplete * 2 > s.Total;
        SetStatus(mismatch
            ? message + " More than half the records are incomplete: check that the right config is loaded."
            : message, isError: mismatch);
    }

    private async Task DownloadCsv()
    {
        if (doc is null) return;
        string name = Path.GetFileNameWithoutExtension(fileName ?? "survey") + "_cleaned.csv";
        await Download(name, "text/csv", doc.ToCsvBytes());
        doc.MarkSaved();

        SurveySummary s = doc.Summary;
        SetStatus(s.NeedingAttention == 0
            ? $"File saved: {name}"
            : $"File saved: {name}. Note: {s.NeedingAttention} flagged rows were saved as they are " +
              $"({s.Incomplete} incomplete, {s.MultipleDistances} multiple distances, {s.TransectErrors} transect errors, " +
              $"{s.DeleteRequests} marked for deletion).");
    }

    private async Task Download(string name, string contentType, byte[] bytes)
    {
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("surveyValidator.downloadFile", name, contentType, streamRef);
    }

    // ---------------------------------------------------------------- config

    /// <summary>Uses the config remembered in this browser, or else the built-in config file.</summary>
    private async Task LoadStartupConfig()
    {
        try
        {
            string? stored = await JS.InvokeAsync<string?>("surveyValidator.getStored", StoredTemplateKey);
            if (!string.IsNullOrWhiteSpace(stored))
            {
                template = SurveyTemplate.Parse(stored);
                templateName = await JS.InvokeAsync<string?>("surveyValidator.getStored", StoredTemplateNameKey) ?? "saved";
            }
        }
        catch (Exception)
        {
            template = null; // a remembered config that can no longer be read is ignored
        }

        if (template is null)
            await LoadBuiltInConfig();
        configLoading = false;
    }

    private async Task<bool> LoadBuiltInConfig()
    {
        try
        {
            template = SurveyTemplate.Parse(await Http.GetStringAsync(BuiltInConfigPath));
            templateName = BuiltInName;
            return true;
        }
        catch (Exception ex)
        {
            SetStatus($"The built-in config could not be read: {ex.Message}", isError: true);
            return false;
        }
    }

    private async Task OnConfigFileChosen(InputFileChangeEventArgs e)
    {
        templateInputKey++;
        SurveyTemplate loaded;
        try
        {
            using Stream stream = e.File.OpenReadStream(MaxConfigFileBytes);
            using var reader = new StreamReader(stream);
            loaded = SurveyTemplate.Parse(await reader.ReadToEndAsync());
        }
        catch (Exception ex)
        {
            SetStatus($"Config not loaded: {ex.Message}", isError: true);
            return;
        }

        await ChangeTemplate(loaded, e.File.Name, remember: true);
    }

    private Task OnRoleChanged(TemplateEntry entry, ChangeEventArgs e)
    {
        if (template is null || !Enum.TryParse(e.Value?.ToString(), out ValueRole role)) return Task.CompletedTask;
        SurveyTemplate changed = template.WithRole(entry.Value, role);
        IReadOnlyList<string> problems = changed.Problems();
        if (problems.Count > 0)
        {
            inputEpoch++;
            SetStatus($"Not changed: the config would then have {string.Join(", ", problems)}.", isError: true);
            return Task.CompletedTask;
        }

        string name = templateName.EndsWith(" (edited)") ? templateName : templateName.Replace(" (built-in)", "") + " (edited)";
        return ChangeTemplate(changed, name, remember: true);
    }

    private Task ResetConfig() =>
        RunUnlessUnsaved(
            $"Changing the config re-reads {fileName} and discards the edits made to it.",
            async () =>
            {
                if (!await LoadBuiltInConfig()) return;
                await JS.InvokeVoidAsync("surveyValidator.removeStored", StoredTemplateKey);
                await JS.InvokeVoidAsync("surveyValidator.removeStored", StoredTemplateNameKey);
                AfterTemplateChanged();
            });

    private Task ChangeTemplate(SurveyTemplate newTemplate, string name, bool remember) =>
        RunUnlessUnsaved(
            $"Changing the config re-reads {fileName} and discards the edits made to it.",
            async () =>
            {
                template = newTemplate;
                templateName = name;
                if (remember)
                {
                    await JS.InvokeVoidAsync("surveyValidator.setStored", StoredTemplateKey, newTemplate.ToText());
                    await JS.InvokeVoidAsync("surveyValidator.setStored", StoredTemplateNameKey, name);
                }
                AfterTemplateChanged();
            });

    private void AfterTemplateChanged()
    {
        if (rawText is not null && fileName is not null)
        {
            LoadData(rawText, fileName);
            if (!statusIsError) SetStatus($"Config in use: {templateName}. {fileName} re-checked.");
        }
        else
        {
            SetStatus($"Config in use: {templateName}.");
        }
    }

    private Task DownloadTemplate() =>
        template is null
            ? Task.CompletedTask
            : Download("survey-template.csv", "text/csv", Encoding.UTF8.GetBytes(template.ToText()));

    // --------------------------------------------------- unsaved-edit guard

    private async Task RunUnlessUnsaved(string message, Func<Task> action)
    {
        if (doc?.IsModified == true)
        {
            pendingMessage = message;
            pendingAction = action;
        }
        else
        {
            await action();
        }
    }

    private async Task ConfirmPending()
    {
        Func<Task>? action = pendingAction;
        pendingAction = null;
        if (action is not null) await action();
    }

    private void CancelPending()
    {
        pendingAction = null;
        inputEpoch++;
        SetStatus("Cancelled. Your edits are unchanged.");
    }

    // ------------------------------------------------------------ filtering

    private void SetFilter(RowFilter newFilter)
    {
        filter = newFilter;
        RefreshView();
    }

    private void RefreshView()
    {
        if (doc is null)
        {
            view = new();
            return;
        }

        view = filter switch
        {
            RowFilter.Incomplete => doc.Records.Where(r => !r.IsComplete).ToList(),
            RowFilter.MultipleDistances => doc.Records.Where(r => r.HasMultipleDistances).ToList(),
            RowFilter.TransectErrors => doc.Records.Where(r => r.TransectError).ToList(),
            RowFilter.DeleteRequests => doc.Records.Where(r => r.DeleteRequested).ToList(),
            _ => doc.Records.ToList()
        };
    }

    private static string? RowClass(SurveyRecord r) => r.Status switch
    {
        RowStatus.TransectError => "row-transect",
        RowStatus.DeleteRequested => "row-delete",
        RowStatus.Incomplete => "row-incomplete",
        RowStatus.MultipleDistances => "row-multi",
        _ => null
    };

    // --------------------------------------------------------------- editing

    private void AfterEdit(SurveyRecord r, string? error)
    {
        if (error is not null)
        {
            inputEpoch++; // re-creates the text boxes so a rejected entry is not left on screen
            SetStatus($"Line {r.Line}: {error}", isError: true);
            return;
        }

        RefreshView();
        SetStatus($"Line {r.Line}: {r.Notes}");
    }

    private void OnSpecies(SurveyRecord r, ChangeEventArgs e) =>
        AfterEdit(r, doc!.SetSpecies(r, e.Value?.ToString()));

    private void OnDistance(SurveyRecord r, ChangeEventArgs e) =>
        AfterEdit(r, doc!.SetDistance(r, e.Value?.ToString()));

    private void ChooseDistance(SurveyRecord r, string distance) =>
        AfterEdit(r, doc!.SetDistance(r, distance));

    private void OnCounts(SurveyRecord r, ChangeEventArgs e) =>
        AfterEdit(r, doc!.SetCounts(r, e.Value?.ToString()));

    private void OnOther(SurveyRecord r, ChangeEventArgs e) =>
        AfterEdit(r, doc!.SetOther(r, e.Value?.ToString()));

    private void KeepRow(SurveyRecord r)
    {
        doc!.KeepRecord(r);
        RefreshView();
        SetStatus($"Line {r.Line} kept: {r.Notes}");
    }

    private void DeleteRow(SurveyRecord r)
    {
        doc!.Delete(r);
        if (ReferenceEquals(editRecord, r)) editRecord = null;
        RefreshView();
        SetStatus($"Line {r.Line} deleted. Use Undo delete to put it back.");
    }

    private void UndoDelete()
    {
        SurveyRecord? restored = doc?.UndoDelete();
        if (restored is null) return;
        RefreshView();
        SetStatus($"Line {restored.Line} restored.");
    }

    private void BeginEdit(SurveyRecord r, int column)
    {
        editRecord = r;
        editColumn = column;
        editText = r.Fixed[column];
        focusEditInput = true;
    }

    private void OnEditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CommitEdit();
        else if (e.Key == "Escape") editRecord = null;
    }

    private void CommitEdit()
    {
        SurveyRecord? r = editRecord;
        if (r is null) return; // already finished (Enter or Escape, followed by the box losing focus)
        editRecord = null;

        if (editText != r.Fixed[editColumn])
        {
            doc!.SetFixed(r, editColumn, editText);
            RefreshView();
            SetStatus($"Line {r.Line}: {SurveyRecord.FixedColumnNames[editColumn]} changed.");
        }
    }
}
